+// %s: a run of non-space characters (leading spaces are skipped by the caller).
+static bool read_store_string(FILE *fp, int order, bool store, VaList *va) {
+  char *p = store ? va_arg(va->ap, char*) : NULL;
   size_t n = order > 0 ? order : SIZE_MAX;
