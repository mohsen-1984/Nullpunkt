+  }
+  if (i == 0)
+    return false;
+  if (p != NULL)
+    *p = '\0';
+  return true;
+}
+
+// %c: exactly `order` characters (1 if no width), white space included, no terminating '\0'.
+static bool read_store_chars(FILE *fp, int order, bool store, VaList *va) {
+  char *p = store ? va_arg(va->ap, char*) : NULL;
+  int n = order > 0 ? order : 1;
+  for (int i = 0; i < n; ++i) {
+    int c = fgetc(fp);
+    if (c == EOF)
+      return i > 0;  // as glibc: a shorter run at the end of the input still counts
+    if (p != NULL)
+      *p++ = c;
+  }
+  return true;
+}
+
+// %[...]: the longest run of characters in the scan set; `*pp` points at '[' and is left at the closing ']'.
+static bool read_store_scanset(FILE *fp, const unsigned char **pp, int order, bool store, VaList *va) {
+  const unsigned char *q = *pp + 1;
+  bool negate = false;
+  if (*q == '^') {
+    negate = true;
+    ++q;
+  }
+  bool set[256];
+  memset(set, 0, sizeof(set));
+  if (*q == ']')  // a ']' right after '[' or '[^' is part of the set
+    set[*q++] = true;
+  for (; *q != '\0' && *q != ']'; ++q) {
+    if (q[1] == '-' && q[2] != ']' && q[2] != '\0') {
+      for (int ch = q[0]; ch <= q[2]; ++ch)
+        set[ch] = true;
+      q += 2;
+    } else {
+      set[*q] = true;
+    }
+  }
+  if (*q != ']')
+    return false;
+  *pp = q;
+
+  char *p = store ? va_arg(va->ap, char*) : NULL;
+  size_t n = order > 0 ? order : SIZE_MAX;
+  size_t i;
+  for (i = 0; i < n; ++i) {
+    int c = fgetc(fp);
+    if (c == EOF)
+      break;
+    if (set[(unsigned char)c] == negate) {
+      ungetc(c, fp);
+      break;
+    }
+    if (p != NULL)
+      *p++ = c;
   }
-  *p = '\0';
+  if (i == 0)
+    return false;
+  if (p != NULL)
+    *p = '\0';
   return true;
 }
 
