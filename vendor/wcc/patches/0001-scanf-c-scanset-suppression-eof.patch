+static bool read_store_llong(FILE *fp, int base, int long_count, bool store, VaList *va) {
   long long x;
   if (!read_llong(fp, base, &x))
     return false;
+  if (!store)
+    return true;
 
   switch (long_count) {
+  case -2: { signed char *p = va_arg(va->ap, signed char*); *p = x; } break;
+  case -1: { short *p = va_arg(va->ap, short*); *p = x; } break;
   case 0:  { int *p = va_arg(va->ap, int*); *p = x; } break;
   case 1:  { long *p = va_arg(va->ap, long*); *p = x; } break;
   default:  { long long *p = va_arg(va->ap, long long*); *p = x; } break;
